// Внутренний HTTP-сервис. Доступ под пользователем 1С, без привилегированного режима.
// Публичная Bearer-аутентификация и входная валидация выполняются Python.

Функция Обработать(Запрос)
    Изменение = Запрос.HTTPМетод <> "GET";
    Попытка
        Если Изменение Тогда
            НачатьТранзакцию();
        КонецЕсли;
        Результат = ВыполнитьМаршрут(Запрос);
        Если Изменение Тогда
            ЗафиксироватьТранзакцию();
        КонецЕсли;
        Возврат Результат;
    Исключение
        Если Изменение И ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        Описание = ОписаниеОшибки();
        НачалоКода = СтрНайти(Описание, "TEMA|");
        Если НачалоКода > 0 Тогда
            Части = СтрРазделить(Сред(Описание, НачалоКода), "|");
            Возврат ОшибкаJSON(Число(Части[1]), Части[2], Части[3]);
        КонецЕсли;
        ЗаписьЖурналаРегистрации("TEMA.API", УровеньЖурналаРегистрации.Ошибка, , , Описание);
        Возврат ОшибкаJSON(500, "ONEC_ERROR", "Операция 1С не выполнена. Подробности в журнале регистрации.");
    КонецПопытки;
КонецФункции

Функция JSONОтвет(Код, Данные)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Cache-Control", "no-store");
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
    Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Код, Имя, Сообщение)
    Возврат JSONОтвет(Код, Новый Структура("error", Новый Структура("code,message,details", Имя, Сообщение, "")));
КонецФункции

Процедура ОшибкаAPI(Код, Имя, Сообщение)
    ВызватьИсключение "TEMA|" + Формат(Код, "ЧГ=0") + "|" + Имя + "|" + Сообщение + "|";
КонецПроцедуры

Функция ТелоJSON(Запрос)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
    Данные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат Данные;
КонецФункции

Функция ЗначениеПоля(Объект, Имя, ПоУмолчанию = Неопределено)
    Значение = Объект[Имя];
    Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
КонецФункции

Функция МенеджерОбъекта(Вид)
    Если Вид = "counterparty" Тогда
        Возврат Справочники.Контрагенты;
    ИначеЕсли Вид = "nomenclature" Тогда
        Возврат Справочники.Номенклатура;
    ИначеЕсли Вид = "order" Тогда
        Возврат Документы.ЗаказПокупателя;
    ИначеЕсли Вид = "invoice" Тогда
        Возврат Документы.СчетНаОплату;
    ИначеЕсли Вид = "act" Тогда
        Возврат Документы.АктВыполненныхРабот;
    КонецЕсли;
    ОшибкаAPI(404, "NOT_FOUND", "Неизвестный вид объекта");
КонецФункции

Функция НайтиОбъект(Вид, Идентификатор)
    Менеджер = МенеджерОбъекта(Вид);
    Попытка
        УИД = Новый УникальныйИдентификатор(Идентификатор);
    Исключение
        УИД = Неопределено;
    КонецПопытки;
    Если УИД <> Неопределено Тогда
        Ссылка = Менеджер.ПолучитьСсылку(УИД);
        Объект = Ссылка.ПолучитьОбъект();
        Если Объект = Неопределено Тогда
            ОшибкаAPI(404, "NOT_FOUND", "Объект не найден");
        КонецЕсли;
    Иначе
        Запрос = Новый Запрос;
        МетаданныеОбъекта = Менеджер.ПустаяСсылка().Метаданные();
        ЭтоСправочник = Вид = "counterparty" Или Вид = "nomenclature";
        Поле = ?(ЭтоСправочник, "Код", "Номер");
        Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2 Ссылка ИЗ "
            + МетаданныеОбъекта.ПолноеИмя() + " ГДЕ " + Поле + " = &Идентификатор И НЕ ПометкаУдаления";
        Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
        Таблица = Запрос.Выполнить().Выгрузить();
        Если Таблица.Количество() = 0 Тогда
            ОшибкаAPI(404, "NOT_FOUND", "Объект не найден");
        ИначеЕсли Таблица.Количество() > 1 Тогда
            ОшибкаAPI(409, "AMBIGUOUS_ID", "Номер неоднозначен. Используйте GUID");
        КонецЕсли;
        Объект = Таблица[0].Ссылка.ПолучитьОбъект();
    КонецЕсли;
    Если Объект.ПометкаУдаления Тогда
        ОшибкаAPI(404, "NOT_FOUND", "Объект помечен на удаление");
    КонецЕсли;
    Возврат Объект;
КонецФункции

Функция ИД(Ссылка)
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ДатаAPI(СтрокаДаты)
    Возврат Дата(Число(Лев(СтрокаДаты, 4)), Число(Сред(СтрокаДаты, 6, 2)), Число(Сред(СтрокаДаты, 9, 2)));
КонецФункции

Процедура ЗаблокироватьДокумент(Ссылка)
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(Ссылка.Метаданные().ПолноеИмя());
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.УстановитьЗначение("Ссылка", Ссылка);
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ЗаписатьДокумент(Объект, Провести = Ложь)
    Если НЕ Объект.ПроверитьЗаполнение() Тогда
        Сообщения = ПолучитьСообщенияПользователю(Истина);
        Текст = "Не заполнены обязательные реквизиты документа";
        Для Каждого Сообщение Из Сообщения Цикл
            Текст = Текст + ". " + Сообщение.Текст;
        КонецЦикла;
        ОшибкаAPI(400, "VALIDATION_ERROR", Лев(СтрЗаменить(Текст, "|", "/"), 1000));
    КонецЕсли;
    Объект.Записать(?(Провести, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
    Возврат Новый Структура("id,guid,number", Объект.Номер, ИД(Объект.Ссылка), Объект.Номер);
КонецФункции

Функция СвязьСделки(Ссылка)
    Запись = РегистрыСведений.TEMA_СвязиСделок.СоздатьМенеджерЗаписи();
    Запись.ИдентификаторДокумента = ИД(Ссылка);
    Запись.Прочитать();
    Возврат ?(Запись.Выбран(), Запись.ИдентификаторСделки, Неопределено);
КонецФункции

Процедура ЗаписатьСвязьСделки(Ссылка, Сделка)
    Если Сделка = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Запись = РегистрыСведений.TEMA_СвязиСделок.СоздатьМенеджерЗаписи();
    Запись.ИдентификаторДокумента = ИД(Ссылка);
    Запись.ИдентификаторСделки = Число(Сделка);
    Запись.Записать();
КонецПроцедуры

Функция ОплатаСчета(Ссылка)
    // Та же формула, что в штатном модуле РасчетыРаботаСФормамиВызовСервера.
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        | ЕСТЬNULL(СУММА(Оплата.СуммаАвансаОборот + Оплата.СуммаОплатыОборот), 0) КАК Оплачено
        | ИЗ РегистрНакопления.ОплатаСчетовИЗаказов.Обороты(, , , СчетНаОплату = &Счет) КАК Оплата";
    Запрос.УстановитьПараметр("Счет", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();
    Оплачено = 0;
    Если Выборка.Следующий() Тогда
        Оплачено = Выборка.Оплачено;
    КонецЕсли;
    Сумма = Ссылка.СуммаДокумента;
    Статус = ?(Оплачено <= 0, "unpaid", ?(Оплачено >= Сумма, "fully_paid", "partially_paid"));
    Возврат Новый Структура("is_paid,paid_amount,remaining_amount,payment_percentage,status",
        Оплачено >= Сумма И Сумма > 0, Оплачено, Макс(0, Сумма - Оплачено),
        ?(Сумма = 0, 0, Окр(Оплачено / Сумма * 100, 2)), Статус);
КонецФункции

Функция КодВалюты(Валюта)
    Коды = Новый Структура("RUB,USD,EUR,CNY,GBP", "643", "840", "978", "156", "826");
    Для Каждого Элемент Из Коды Цикл
        Если Валюта.Код = Элемент.Значение Тогда
            Возврат Элемент.Ключ;
        КонецЕсли;
    КонецЦикла;
    ОшибкаAPI(503, "CURRENCY_MAPPING_REQUIRED", "Требуется настройка ISO-кода валюты");
КонецФункции

Функция ДокументJSON(Вид, Объект)
    Клиент = Новый Структура("id,name,inn", Объект.Контрагент.Код, Строка(Объект.Контрагент), Объект.Контрагент.ИНН);
    Результат = Новый Структура("id,guid,number,date,customer,is_posted", Объект.Номер, ИД(Объект.Ссылка),
        Объект.Номер, Формат(Объект.Дата, "ДФ=yyyy-MM-dd"), Клиент, Объект.Проведен);
    Результат.Вставить("amocrm_lead_id", СвязьСделки(Объект.Ссылка));
    Если Вид = "order" Тогда
        Результат.Вставить("total_amount", Объект.СуммаДокумента);
        Результат.Вставить("_state", ?(ЗначениеЗаполнено(Объект.СостояниеЗаказа), ИД(Объект.СостояниеЗаказа), ""));
    Иначе
        Результат.Вставить("amount", Объект.СуммаДокумента);
        Результат.Вставить("organization", Строка(Объект.Организация));
        Основа = "/api/v1/" + Вид + "/" + ИД(Объект.Ссылка);
        Результат.Вставить("links", Новый Структура("self,pdf", Основа, Основа + "/pdf"));
    КонецЕсли;
    Если Вид = "act" Тогда
        Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
            Основание = Объект.ДокументОснование;
            Результат.Вставить("invoice", Новый Структура("id,guid,number,date", Основание.Номер,
                ИД(Основание), Основание.Номер, Формат(Основание.Дата, "ДФ=yyyy-MM-dd")));
        Иначе
            Результат.Вставить("invoice", Неопределено);
        КонецЕсли;
        Возврат Результат;
    КонецЕсли;
    Строки = Новый Массив;
    Таблицы = Новый Массив;
    Таблицы.Добавить(Объект.Запасы);
    Если Вид = "order" Тогда
        Таблицы.Добавить(Объект.Работы);
    КонецЕсли;
    НДС = 0;
    Для Каждого Таблица Из Таблицы Цикл
        Для Каждого СтрокаТовара Из Таблица Цикл
            Товар = Новый Структура("id,name", СтрокаТовара.Номенклатура.Код, Строка(СтрокаТовара.Номенклатура));
            Элемент = Новый Структура("id,product,quantity,price,total", Строки.Количество() + 1, Товар,
                СтрокаТовара.Количество, СтрокаТовара.Цена, СтрокаТовара.Всего);
            Если Вид = "invoice" Тогда
                Элемент.Вставить("unit", Строка(СтрокаТовара.ЕдиницаИзмерения));
                Элемент.Вставить("vat", Строка(СтрокаТовара.СтавкаНДС));
                Элемент.Вставить("vat_amount", СтрокаТовара.СуммаНДС);
                НДС = НДС + СтрокаТовара.СуммаНДС;
            КонецЕсли;
            Строки.Добавить(Элемент);
        КонецЦикла;
    КонецЦикла;
    Результат.Вставить("items", Строки);
    Если Вид = "invoice" Тогда
        Результат.Вставить("currency", КодВалюты(Объект.ВалютаДокумента));
        Результат.Вставить("vat_amount", НДС + Объект.СуммаНДСДоставки);
        Результат.Вставить("payment", ОплатаСчета(Объект.Ссылка));
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция СоздатьСчетИлиАкт(Вид, Данные)
    Если Вид = "invoice" Тогда
        Основание = НайтиОбъект("order", Данные["order_id"]);
        Объект = Документы.СчетНаОплату.СоздатьДокумент();
    Иначе
        Основание = НайтиОбъект("invoice", Данные["invoice_id"]);
        Объект = Документы.АктВыполненныхРабот.СоздатьДокумент();
    КонецЕсли;
    ЗаблокироватьДокумент(Основание.Ссылка);
    Объект.Дата = ДатаAPI(Данные["date"]);
    Объект.Заполнить(Основание.Ссылка);
    Объект.Дата = ДатаAPI(Данные["date"]);
    Если Данные["comment"] <> Неопределено Тогда
        Объект.Комментарий = Данные["comment"];
    КонецЕсли;
    Если Данные["responsible_person"] <> Неопределено Тогда
        Объект.Ответственный = НайтиСотрудника(Данные["responsible_person"]);
    КонецЕсли;
    Если Вид = "act" И Объект.РаботыИУслуги.Количество() = 0 Тогда
        ОшибкаAPI(400, "NO_SERVICES", "Счет не содержит работ или услуг для акта");
    КонецЕсли;
    Результат = ЗаписатьДокумент(Объект);
    Сделка = ЗначениеПоля(Данные, "amocrm_lead_id", СвязьСделки(Основание.Ссылка));
    ЗаписатьСвязьСделки(Объект.Ссылка, Сделка);
    Возврат Результат;
КонецФункции

Функция НайтиСотрудника(Имя)
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.Сотрудники ГДЕ Наименование = &Имя И НЕ ПометкаУдаления");
    Запрос.УстановитьПараметр("Имя", Имя);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() <> 1 Тогда
        ОшибкаAPI(400, "EMPLOYEE_NOT_FOUND", "Ответственный не найден однозначно по наименованию");
    КонецЕсли;
    Возврат Таблица[0].Ссылка;
КонецФункции

Функция СоздатьПлатеж(Идентификатор, Данные)
    Счет = НайтиОбъект("invoice", Идентификатор);
    ЗаблокироватьДокумент(Счет.Ссылка);
    Если Данные["payment_method"] <> "bank_transfer" Тогда
        ОшибкаAPI(400, "PAYMENT_METHOD_UNSUPPORTED", "Сейчас поддержан только bank_transfer");
    КонецЕсли;
    Если Данные["currency"] <> КодВалюты(Счет.ВалютаДокумента) Тогда
        ОшибкаAPI(400, "CURRENCY_MISMATCH", "Валюта платежа должна совпадать с валютой счета");
    КонецЕсли;
    Платеж = Документы.ПоступлениеНаСчет.СоздатьДокумент();
    Платеж.Дата = ДатаAPI(Данные["date"]);
    Платеж.ЗаполнитьПоСчетуНаОплату(Счет.Ссылка, , Число(Данные["amount"]));
    Платеж.Дата = ДатаAPI(Данные["date"]);
    Если НЕ ЗначениеЗаполнено(Платеж.Статья) Тогда
        Платеж.Статья = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаОтПокупателей;
    КонецЕсли;
    Если Данные["bank_account"] <> Неопределено Тогда
        Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.БанковскиеСчета ГДЕ НомерСчета = &Номер И Владелец = &Организация И НЕ ПометкаУдаления");
        Запрос.УстановитьПараметр("Номер", Данные["bank_account"]);
        Запрос.УстановитьПараметр("Организация", Счет.Организация);
        Таблица = Запрос.Выполнить().Выгрузить();
        Если Таблица.Количество() <> 1 Тогда
            ОшибкаAPI(400, "BANK_ACCOUNT_NOT_FOUND", "Банковский счет организации не найден однозначно");
        КонецЕсли;
        Платеж.БанковскийСчет = Таблица[0].Ссылка;
    КонецЕсли;
    Платеж.НазначениеПлатежа = ЗначениеПоля(Данные, "description", "Оплата по счету " + Счет.Номер);
    Возврат ЗаписатьДокумент(Платеж, Истина);
КонецФункции

Функция ИзменитьДокумент(Вид, Идентификатор, Данные)
    Объект = НайтиОбъект(Вид, Идентификатор);
    ЗаблокироватьДокумент(Объект.Ссылка);
    Объект = Объект.Ссылка.ПолучитьОбъект();
    Если Объект.Проведен Тогда
        ОшибкаAPI(409, "POSTED_DOCUMENT", "Проведенный документ нельзя изменять без отмены проведения");
    КонецЕсли;
    Если Данные["date"] <> Неопределено Тогда
        Объект.Дата = ДатаAPI(Данные["date"]);
    КонецЕсли;
    Если Данные["comment"] <> Неопределено Тогда
        Объект.Комментарий = Данные["comment"];
    КонецЕсли;
    Если Данные["responsible_person"] <> Неопределено Тогда
        Объект.Ответственный = НайтиСотрудника(Данные["responsible_person"]);
    КонецЕсли;
    Если Вид = "order" Тогда
        ЗаполнитьЗаказ(Объект, Данные);
    ИначеЕсли Данные["order_id"] <> Неопределено Тогда
        ОшибкаAPI(400, "IMMUTABLE_SOURCE", "Основание существующего счета менять нельзя");
    КонецЕсли;
    Результат = ЗаписатьДокумент(Объект);
    ЗаписатьСвязьСделки(Объект.Ссылка, Данные["amocrm_lead_id"]);
    Возврат Результат;
КонецФункции

Процедура ЗаполнитьЗаказ(Объект, Данные)
    Если Данные["customer"] <> Неопределено Тогда
        Клиент = НайтиОбъект("counterparty", Данные["customer"]["id"]);
        Если НЕ Объект.ЭтоНовый() И Объект.Контрагент <> Клиент.Ссылка Тогда
            ОшибкаAPI(409, "CUSTOMER_CHANGE", "Для другого контрагента создайте новый заказ");
        КонецЕсли;
        Если Объект.ЭтоНовый() Тогда
            ПараметрыЗаполнения = Новый Структура("Контрагент,Дата", Клиент.Ссылка, Объект.Дата);
            Если Данные["_organization_guid"] <> Неопределено Тогда
                Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные["_organization_guid"]));
                ПараметрыЗаполнения.Вставить("Организация", Организация);
            КонецЕсли;
            Объект.Заполнить(ПараметрыЗаполнения);
            Объект.Контрагент = Клиент.Ссылка;
        КонецЕсли;
    КонецЕсли;
    Если Данные["_state_guid"] <> Неопределено Тогда
        Объект.СостояниеЗаказа = Справочники.СостоянияЗаказовПокупателей.ПолучитьСсылку(
            Новый УникальныйИдентификатор(Данные["_state_guid"]));
    КонецЕсли;
    Если Данные["items"] = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Объект.Запасы.Очистить();
    Объект.Работы.Очистить();
    Для Каждого Элемент Из Данные["items"] Цикл
        Номенклатура = НайтиОбъект("nomenclature", Элемент["product_id"]);
        ЭтоЗапас = Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
        Если НЕ ЭтоЗапас И Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Услуга
            И Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Работа Тогда
            ОшибкаAPI(400, "PRODUCT_TYPE_UNSUPPORTED", "Поддержаны товары, работы и услуги");
        КонецЕсли;
        Таблица = ?(ЭтоЗапас, Объект.Запасы, Объект.Работы);
        Строка = Таблица.Добавить();
        Строка.Номенклатура = Номенклатура.Ссылка;
        Строка.Количество = Число(Элемент["quantity"]);
        Строка.Цена = Число(Элемент["price"]);
        ВидСтавки = Номенклатура.ВидСтавкиНДС;
        Если НЕ ЗначениеЗаполнено(ВидСтавки) Тогда
            ВидСтавки = Объект.Организация.ВидСтавкиНДСПоУмолчанию;
        КонецЕсли;
        Строка.СтавкаНДС = Справочники.СтавкиНДС.СтавкаНДС(ВидСтавки, Объект.Дата);
        Строка.КлючСвязи = Таблица.Количество();
        Если ЭтоЗапас Тогда
            Строка.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
            Строка.ТипНоменклатурыЗапас = Истина;
        Иначе
            Строка.Кратность = 1;
            Строка.Коэффициент = 1;
            Строка.ТипНоменклатурыУслуга = Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
        КонецЕсли;
        Параметры = Новый Структура("СуммаВключаетНДС,РассчитатьСуммуСкидки", Объект.СуммаВключаетНДС, Истина);
        ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(Строка, Параметры);
    КонецЦикла;
КонецПроцедуры

Функция СоздатьЗаказ(Данные)
    Объект = Документы.ЗаказПокупателя.СоздатьДокумент();
    Объект.Дата = ДатаAPI(Данные["date"]);
    ЗаполнитьЗаказ(Объект, Данные);
    Объект.Дата = ДатаAPI(Данные["date"]);
    Если НЕ ЗначениеЗаполнено(Объект.ДатаОтгрузки) Тогда
        Объект.ДатаОтгрузки = Объект.Дата;
    КонецЕсли;
    Объект.Комментарий = ЗначениеПоля(Данные, "comment", "");
    Результат = ЗаписатьДокумент(Объект);
    ЗаписатьСвязьСделки(Объект.Ссылка, Данные["amocrm_lead_id"]);
    Возврат Результат;
КонецФункции

Функция PDFДокумента(Вид, Идентификатор, Команда)
    Объект = НайтиОбъект(Вид, Идентификатор);
    Если Вид = "invoice" Тогда
        ИдентификаторКоманды = Обработки.ПечатьСчетНаОплату.ИдентификаторПечатнойФормы(Ложь, Ложь);
    ИначеЕсли Вид = "act" Тогда
        ИдентификаторКоманды = Обработки.ПечатьАктаОбОказанииУслуг.ИдентификаторПечатнойФормы(Ложь, Ложь);
    Иначе
        ИдентификаторКоманды = Команда;
    КонецЕсли;
    Команды = УправлениеПечатью.КомандыПечатиОбъекта(Объект.Метаданные());
    КомандаПечати = Команды.Найти(ИдентификаторКоманды, "Идентификатор");
    Если КомандаПечати = Неопределено Тогда
        ОшибкаAPI(400, "PRINT_COMMAND_NOT_FOUND", "Команда печати не найдена. Настройте print_commands в Python");
    КонецЕсли;
    СтруктураКоманды = Новый Структура;
    Для Каждого Колонка Из Команды.Колонки Цикл
        СтруктураКоманды.Вставить(Колонка.Имя, КомандаПечати[Колонка.Имя]);
    КонецЦикла;
    Ссылки = Новый Массив;
    Ссылки.Добавить(Объект.Ссылка);
    Настройки = УправлениеПечатью.НастройкиСохранения();
    Настройки.ФорматыСохранения = Новый Массив;
    Настройки.ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.PDF);
    Настройки.УпаковатьВАрхив = Ложь;
    Файлы = УправлениеПечатью.НапечататьВФайл(СтруктураКоманды, Ссылки, Настройки);
    Если Файлы.Количество() <> 1 Тогда
        ОшибкаAPI(500, "PDF_COUNT", "Печатная форма не вернула один PDF");
    КонецЕсли;
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/pdf");
    Ответ.Заголовки.Вставить("Content-Disposition", "inline; filename=document.pdf");
    Ответ.УстановитьТелоИзДвоичныхДанных(Файлы[0].ДвоичныеДанные);
    Возврат Ответ;
КонецФункции

Функция ЗаписатьКонтрагента(Идентификатор, Данные)
    Объект = ?(Идентификатор = "", Справочники.Контрагенты.СоздатьЭлемент(), НайтиОбъект("counterparty", Идентификатор));
    Если Идентификатор = "" Тогда
        Объект.Заполнить(Новый Структура);
    КонецЕсли;
    СоответствиеПолей = Новый Структура("name,full_name,inn,kpp,ogrn", "Наименование", "НаименованиеПолное", "ИНН", "КПП", "РегистрационныйНомер");
    Для Каждого Поле Из СоответствиеПолей Цикл
        Если Данные[Поле.Ключ] <> Неопределено Тогда
            Объект[Поле.Значение] = Данные[Поле.Ключ];
        КонецЕсли;
    КонецЦикла;
    Если Данные["type"] <> Неопределено Тогда
        Объект.ВидКонтрагента = Перечисления.ВидыКонтрагентов[Данные["type"]];
    КонецЕсли;
    Если Данные["is_active"] <> Неопределено Тогда
        Объект.Недействителен = НЕ Данные["is_active"];
    КонецЕсли;
    Если ЗначениеЗаполнено(Объект.ИНН) Тогда
        Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты ГДЕ ИНН = &ИНН И КПП = &КПП И Ссылка <> &Ссылка И НЕ ПометкаУдаления И НЕ ЭтоГруппа");
        Запрос.УстановитьПараметр("ИНН", Объект.ИНН);
        Запрос.УстановитьПараметр("КПП", Объект.КПП);
        Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
        Если НЕ Запрос.Выполнить().Пустой() Тогда
            ОшибкаAPI(409, "DUPLICATE", "Контрагент с таким ИНН и КПП уже существует");
        КонецЕсли;
    КонецЕсли;
    Если Данные["roles"] <> Неопределено Тогда
        Роли = Данные["roles"];
        Для Каждого Роль Из Новый Структура("is_customer,is_supplier,is_other", "Покупатель", "Поставщик", "ПрочиеОтношения") Цикл
            Если Роли[Роль.Ключ] <> Неопределено Тогда
                Объект[Роль.Значение] = Роли[Роль.Ключ];
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Данные["contact_info"] <> Неопределено Тогда
        ОбновленныеВиды = Новый Соответствие;
        Для Каждого Контакт Из Данные["contact_info"] Цикл
            Если Контакт["type"] = "Телефон" Тогда
                ВидКонтакта = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
            ИначеЕсли Контакт["type"] = "Электронная почта" Тогда
                ВидКонтакта = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
            Иначе
                ОшибкаAPI(400, "CONTACT_TYPE_UNSUPPORTED", "Поддержаны Телефон и Электронная почта");
            КонецЕсли;
            Замещать = ОбновленныеВиды[ВидКонтакта] = Неопределено;
            Если Замещать Тогда
                Для Каждого СтараяСтрока Из Объект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", ВидКонтакта)) Цикл
                    Объект.КонтактнаяИнформация.Удалить(СтараяСтрока);
                КонецЦикла;
            КонецЕсли;
            УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, Контакт["value"], ВидКонтакта, , Замещать);
            ОбновленныеВиды.Вставить(ВидКонтакта, Истина);
        КонецЦикла;
    КонецЕсли;
    Если НЕ Объект.ПроверитьЗаполнение() Тогда
        ОшибкаAPI(400, "VALIDATION_ERROR", "Не заполнены обязательные поля контрагента");
    КонецЕсли;
    Объект.Записать();
    Возврат Новый Структура("id,guid", Объект.Код, ИД(Объект.Ссылка));
КонецФункции

Функция СписокСчетов(Параметры)
    // Accounting filters precede both total and pagination.
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ Документ.СчетНаОплату ГДЕ НЕ ПометкаУдаления УПОРЯДОЧИТЬ ПО Дата УБЫВ, Ссылка");
    Если Параметры["date_from"] <> Неопределено Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ НЕ ПометкаУдаления", "ГДЕ НЕ ПометкаУдаления И Дата >= &СДата");
        Запрос.УстановитьПараметр("СДата", ДатаAPI(Параметры["date_from"]));
    КонецЕсли;
    Если Параметры["date_to"] <> Неопределено Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ НЕ ПометкаУдаления", "ГДЕ НЕ ПометкаУдаления И Дата <= &ПоДата");
        Запрос.УстановитьПараметр("ПоДата", КонецДня(ДатаAPI(Параметры["date_to"])));
    КонецЕсли;
    Если Параметры["customer_id"] <> Неопределено Тогда
        Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ НЕ ПометкаУдаления", "ГДЕ НЕ ПометкаУдаления И Контрагент = &Контрагент");
        Запрос.УстановитьПараметр("Контрагент", НайтиОбъект("counterparty", Параметры["customer_id"]).Ссылка);
    КонецЕсли;
    Страница = Число(ЗначениеПоля(Параметры, "page", "1"));
    Лимит = Число(ЗначениеПоля(Параметры, "limit", "50"));
    Статус = ЗначениеПоля(Параметры, "status", "");
    Если Статус = "paid" Тогда
        Статус = "fully_paid";
    ИначеЕсли Статус = "partially" Тогда
        Статус = "partially_paid";
    КонецЕсли;
    Всего = 0;
    Данные = Новый Массив;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ссылка = Выборка.Ссылка;
        Если Параметры["search"] <> Неопределено И СтрНайти(НРег(Ссылка.Номер), НРег(Параметры["search"])) = 0 Тогда
            Продолжить;
        КонецЕсли;
        Если Статус <> "" И ОплатаСчета(Ссылка).status <> Статус Тогда
            Продолжить;
        КонецЕсли;
        Если Параметры["lead_id"] <> Неопределено И СвязьСделки(Ссылка) <> Число(Параметры["lead_id"]) Тогда
            Продолжить;
        КонецЕсли;
        Всего = Всего + 1;
        Если Всего > (Страница - 1) * Лимит И Всего <= Страница * Лимит Тогда
            Данные.Добавить(ДокументJSON("invoice", Ссылка.ПолучитьОбъект()));
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("total,page,limit,data", Всего, Страница, Лимит, Данные);
КонецФункции

Функция ВыполнитьМаршрут(Запрос)
    Части = СтрРазделить(Запрос.ОтносительныйURL, "/", Ложь);
    Параметры = Новый Соответствие;
    Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
        Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
    КонецЦикла;
    Если Части.Количество() = 1 И Части[0] = "health" И Запрос.HTTPМетод = "GET" Тогда
        Возврат JSONОтвет(200, Новый Структура("status,configuration,version", "ok", Метаданные.Имя, Метаданные.Версия));
    КонецЕсли;
    Если Части.Количество() = 0 Тогда
        Возврат ОшибкаJSON(404, "NOT_FOUND", "Маршрут не найден");
    КонецЕсли;
    Вид = Части[0];
    Метод = Запрос.HTTPМетод;
    Если Метод = "GET" И Вид = "invoices" И Части.Количество() = 1 Тогда
        Возврат JSONОтвет(200, СписокСчетов(Параметры));
    КонецЕсли;
    Если Метод = "GET" И Части.Количество() = 2 Тогда
        Возврат JSONОтвет(200, ДокументJSON(Вид, НайтиОбъект(Вид, Части[1])));
    ИначеЕсли Метод = "GET" И Части.Количество() >= 3 И Части[Части.ВГраница()] = "pdf" Тогда
        Возврат PDFДокумента(Вид, Части[1], ЗначениеПоля(Параметры, "command", ""));
    КонецЕсли;
    Данные = ТелоJSON(Запрос);
    Если Метод = "POST" И Части.Количество() = 1 Тогда
        Если Вид = "invoice" Или Вид = "act" Тогда
            Результат = СоздатьСчетИлиАкт(Вид, Данные);
        ИначеЕсли Вид = "order" Тогда
            Результат = СоздатьЗаказ(Данные);
        ИначеЕсли Вид = "counterparty" Тогда
            Возврат JSONОтвет(201, Новый Структура("status,data", "success", ЗаписатьКонтрагента("", Данные)));
        Иначе
            Возврат ОшибкаJSON(404, "NOT_FOUND", "Маршрут не найден");
        КонецЕсли;
        Возврат JSONОтвет(201, Новый Структура("status,message,data", "success", "Документ создан", Результат));
    ИначеЕсли Метод = "POST" И Вид = "invoice" И Части.Количество() = 3 И Части[2] = "payment" Тогда
        Возврат JSONОтвет(201, Новый Структура("status,data", "success", СоздатьПлатеж(Части[1], Данные)));
    ИначеЕсли Метод = "PATCH" И Части.Количество() = 2 Тогда
        Если Вид = "counterparty" Тогда
            Возврат JSONОтвет(200, Новый Структура("status,data", "success", ЗаписатьКонтрагента(Части[1], Данные)));
        КонецЕсли;
        Возврат JSONОтвет(200, Новый Структура("status,data", "success", ИзменитьДокумент(Вид, Части[1], Данные)));
    КонецЕсли;
    Возврат ОшибкаJSON(404, "NOT_FOUND", "Маршрут не найден");
КонецФункции
